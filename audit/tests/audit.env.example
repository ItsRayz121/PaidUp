# Approved isolated target only. Never point this at production or Telegram/Resend.
BASE_URL=http://127.0.0.1:4000
TOKENS_FILE=./tokens.json
TARGET_RPS=10
DURATION=2m
PREALLOCATED_VUS=20
MAX_VUS=100
THINK_SECONDS=0

# Provisional profiles to run separately after the baseline passes:
# 10,000 active users x one action / 20s = 500 actions/s.
# 100,000 active users x one action / 20s = 5,000 actions/s.
# These are offered-load models, not claims about real traffic or capacity.

